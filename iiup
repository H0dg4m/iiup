#!/usr/bin/env bash
# iiup — safe git-based dotfiles updater / güvenli dotfiles güncelleyici
# Flow: setup → check → update → ok | restore
set -euo pipefail

VERSION="2.2.1"
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd)"
SCRIPT_PATH="$SCRIPT_DIR/$(basename -- "$SCRIPT_PATH")"

# ─── Language (IIUP_LANG=en|tr, else LANG) ────────────────────────────────────
detect_lang() {
  local raw loc
  raw="${IIUP_LANG:-}"
  if [[ -n "$raw" ]]; then
    case "${raw,,}" in
      tr|tr_*|turkish|türkçe|turkce) IIUP_LANG=tr ;;
      *) IIUP_LANG=en ;;
    esac
    return
  fi
  loc="${LC_ALL:-${LC_MESSAGES:-${LANG:-en_US}}}"
  case "${loc,,}" in
    tr|tr_*|*.tr) IIUP_LANG=tr ;;
    *) IIUP_LANG=en ;;
  esac
}
detect_lang

# m "English" "Türkçe"
m() {
  if [[ "${IIUP_LANG}" == "tr" ]]; then
    printf '%s' "$2"
  else
    printf '%s' "$1"
  fi
}

# ─── Log ──────────────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  C_RST=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YLW=$'\033[33m'; C_CYN=$'\033[36m'
else
  C_RST=; C_DIM=; C_BOLD=; C_RED=; C_GRN=; C_YLW=; C_CYN=
fi

info() { printf "${C_CYN}==>${C_RST} %s\n" "$*" >&2; }
ok()   { printf "${C_GRN}✓${C_RST} %s\n" "$*" >&2; }
warn() { printf "${C_YLW}!${C_RST} %s\n" "$*" >&2; }
err()  { printf "${C_RED}✗${C_RST} %s\n" "$*" >&2; }
die()  { err "$*"; exit 1; }

ask() {
  local __var="$1" __q="$2" __def="${3:-}" __ans
  if [[ -n "$__def" ]]; then
    read -r -p "$__q [$__def]: " __ans || true
    __ans="${__ans:-$__def}"
  else
    while true; do
      read -r -p "$__q: " __ans || true
      [[ -n "$__ans" ]] && break
      warn "$(m "This field is required." "Bu alan zorunlu.")"
    done
  fi
  printf -v "$__var" '%s' "$__ans"
}

confirm() {
  local q="$1" def="${2:-N}" ans
  if [[ "$def" =~ ^[yY]$ ]]; then
    read -r -p "$q [Y/n] " ans || true
    [[ -z "${ans:-}" || "$ans" =~ ^[yY]$ ]]
  else
    read -r -p "$q [y/N] " ans || true
    [[ "${ans:-}" =~ ^[yY]$ ]]
  fi
}

# ─── XDG / config (no default dots repo) ──────────────────────────────────────
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"

IIUP_CONFIG_DIR="${IIUP_CONFIG_DIR:-$XDG_CONFIG_HOME/iiup}"
IIUP_CONFIG="${IIUP_CONFIG:-$IIUP_CONFIG_DIR/config}"
IIUP_STATE_DIR="${IIUP_STATE_DIR:-$XDG_STATE_HOME/iiup}"
BACKUP_ROOT="${BACKUP_ROOT:-$IIUP_STATE_DIR/backups}"
PENDING_FILE="${PENDING_FILE:-$IIUP_STATE_DIR/pending}"
LOG_DIR="${LOG_DIR:-$IIUP_STATE_DIR/logs}"

REPO_URL="${REPO_URL:-}"
REPO_DIR="${REPO_DIR:-}"
REPO_BRANCH="${REPO_BRANCH:-main}"
DOTS_NAME="${DOTS_NAME:-}"
UPDATE_CMD="${UPDATE_CMD:-}"
UPDATE_MODE="${UPDATE_MODE:-}"
SETUP_ARGS="${SETUP_ARGS:-}"

KEEP_BACKUPS="${KEEP_BACKUPS:-${KEEP_FAILED_BACKUPS:-5}}"
NOTIFY="${NOTIFY:-1}"
FORCE_UPDATE="${FORCE_UPDATE:-0}"
ASSUME_YES="${ASSUME_YES:-0}"
CHECK_ON_CALENDAR="${CHECK_ON_CALENDAR:-daily}"
UNIT_NAME="iiup-check"

# ─── Helpers ──────────────────────────────────────────────────────────────────
need_cmd() { command -v "$1" >/dev/null 2>&1 || die "$(m "'$1' not found." "'$1' bulunamadı.")"; }

resolve_icon() {
  # Prefer absolute path so notifications always show a logo
  if [[ -n "${IIUP_ICON:-}" && -e "$IIUP_ICON" ]]; then
    printf '%s\n' "$IIUP_ICON"
    return
  fi
  local p
  for p in \
    "$HOME/.local/share/icons/hicolor/128x128/apps/iiup.png" \
    "$HOME/.local/share/icons/hicolor/64x64/apps/iiup.png" \
    "$HOME/.local/share/icons/hicolor/48x48/apps/iiup.png" \
    "$HOME/.local/share/pixmaps/iiup.png" \
    "$SCRIPT_DIR/assets/iiup-128.png" \
    "$SCRIPT_DIR/assets/iiup.svg"
  do
    if [[ -f "$p" ]]; then
      printf '%s\n' "$p"
      return
    fi
  done
  printf '%s\n' "iiup"
}

notify() {
  [[ "$NOTIFY" == "1" ]] || return 0
  command -v notify-send >/dev/null 2>&1 || return 0
  local urgency="normal" title body icon
  case "${1:-}" in
    low|normal|critical) urgency="$1"; shift ;;
  esac
  title="${1:-iiup}"
  body="${2:-}"
  icon="$(resolve_icon)"
  notify-send -a iiup -u "$urgency" -i "$icon" \
    --hint=string:desktop-entry:iiup \
    "$title" "$body" 2>/dev/null || true
}

install_desktop_assets() {
  local src="$SCRIPT_DIR/assets" s d
  [[ -f "$src/iiup.svg" ]] || return 0

  mkdir -p "$HOME/.local/share/applications" \
           "$HOME/.local/share/pixmaps" \
           "$HOME/.local/share/icons/hicolor/scalable/apps"

  cp -f "$src/iiup.svg" "$HOME/.local/share/icons/hicolor/scalable/apps/iiup.svg"

  if command -v rsvg-convert >/dev/null 2>&1; then
    for s in 16 24 32 48 64 128 256 512; do
      d="$HOME/.local/share/icons/hicolor/${s}x${s}/apps"
      mkdir -p "$d"
      rsvg-convert -w "$s" -h "$s" "$src/iiup.svg" -o "$d/iiup.png"
      # keep repo assets in sync when writable
      rsvg-convert -w "$s" -h "$s" "$src/iiup.svg" -o "$src/iiup-${s}.png" 2>/dev/null || true
    done
    cp -f "$HOME/.local/share/icons/hicolor/128x128/apps/iiup.png" \
      "$HOME/.local/share/pixmaps/iiup.png"
  elif [[ -f "$src/iiup-128.png" ]]; then
    for s in 48 64 128 256; do
      d="$HOME/.local/share/icons/hicolor/${s}x${s}/apps"
      mkdir -p "$d"
      if [[ -f "$src/iiup-${s}.png" ]]; then
        cp -f "$src/iiup-${s}.png" "$d/iiup.png"
      else
        cp -f "$src/iiup-128.png" "$d/iiup.png"
      fi
    done
    cp -f "$src/iiup-128.png" "$HOME/.local/share/pixmaps/iiup.png"
  fi

  cat >"$HOME/.local/share/applications/iiup.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=iiup
GenericName=Dotfiles updater
GenericName[tr]=Dotfiles güncelleyici
Comment=Safe git-based dotfiles updater
Comment[tr]=Git tabanlı güvenli dotfiles güncelleyici
Exec=$HOME/.local/bin/iiup status
Icon=iiup
Terminal=true
Categories=System;Utility;
StartupNotify=false
EOF

  command -v gtk-update-icon-cache >/dev/null 2>&1 && \
    gtk-update-icon-cache -f "$HOME/.local/share/icons/hicolor" >/dev/null 2>&1 || true
  command -v update-desktop-database >/dev/null 2>&1 && \
    update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true

  ok "$(m "Icon + desktop entry installed" "Logo ve masaüstü girişi kuruldu")"
}

ensure_dirs() {
  mkdir -p "$IIUP_CONFIG_DIR" "$BACKUP_ROOT" "$LOG_DIR" "$IIUP_STATE_DIR"
}

load_config() {
  if [[ -f "$IIUP_CONFIG" ]]; then
    # shellcheck disable=SC1090
    source "$IIUP_CONFIG"
  fi
  # Re-apply language if config sets IIUP_LANG
  detect_lang
  if [[ -z "${UPDATE_CMD:-}" && -n "${UPDATE_MODE:-}" ]]; then
    UPDATE_CMD="./setup ${UPDATE_MODE}${SETUP_ARGS:+ $SETUP_ARGS}"
  fi
  if [[ -z "${DOTS_NAME:-}" && -n "${REPO_URL:-}" ]]; then
    DOTS_NAME="$(basename "${REPO_URL%.git}")"
  fi
  KEEP_BACKUPS="${KEEP_BACKUPS:-${KEEP_FAILED_BACKUPS:-5}}"
}

is_configured() {
  [[ -n "${REPO_URL:-}" && -n "${REPO_DIR:-}" ]]
}

require_configured() {
  load_config
  if is_configured; then
    return 0
  fi
  err "$(m "No dots repo configured yet." "Henüz dots tanımlı değil.")"
  if [[ -t 0 && -t 1 ]]; then
    info "$(m "Starting first-time setup…" "İlk kurulum başlıyor…")"
    cmd_setup
    load_config
    is_configured || die "$(m "Setup was not completed." "Kurulum tamamlanmadı.")"
    return 0
  fi
  printf "%s ${C_GRN}iiup setup${C_RST}\n" "$(m "Run:" "Çalıştır:")" >&2
  exit 2
}

repo_basename_from_url() {
  local name
  name="$(basename "${1%.git}")"
  printf '%s\n' "${name:-dots}"
}

suggest_update_cmd() {
  local dir="$1"
  if [[ -x "$dir/setup" ]]; then
    printf '%s\n' "./setup"
  elif [[ -x "$dir/install.sh" ]]; then
    printf '%s\n' "./install.sh"
  elif [[ -f "$dir/install.sh" ]]; then
    printf '%s\n' "bash ./install.sh"
  elif [[ -x "$dir/install" ]]; then
    printf '%s\n' "./install"
  else
    printf '%s\n' ""
  fi
}

expand_path() {
  local p="$1"
  p="${p/#\~/$HOME}"
  # shellcheck disable=SC2086
  eval "p=$p"
  printf '%s\n' "$p"
}

write_config_file() {
  ensure_dirs
  cat >"$IIUP_CONFIG" <<EOF
# iiup config — created by iiup setup ($(date -Iseconds))
# Language: IIUP_LANG=en|tr  (optional)

DOTS_NAME="$DOTS_NAME"
REPO_URL="$REPO_URL"
REPO_DIR="$REPO_DIR"
REPO_BRANCH="$REPO_BRANCH"

# Command after git pull (empty = git only)
# Examples: "./install.sh"  |  "./setup"  |  "stow -R -t \$HOME ."
UPDATE_CMD="$UPDATE_CMD"

NOTIFY=$NOTIFY
KEEP_BACKUPS=$KEEP_BACKUPS
CHECK_ON_CALENDAR="$CHECK_ON_CALENDAR"
EOF
  ok "$(m "Config:" "Config:") $IIUP_CONFIG"
}

write_paths_template() {
  local path="$IIUP_CONFIG_DIR/paths.list"
  [[ -f "$path" ]] && return 0
  cat >"$path" <<'PL'
# Paths to back up before update (one per line)
# Güncellemeden önce yedeklenecek yollar (satır başına bir)
# ~ or $HOME allowed. Can be left empty.
#
# $HOME/.config/hypr/custom
# $HOME/.config/kitty
# $HOME/.config/fish
PL
  ok "$(m "Backup list:" "Yedek listesi:") $path"
}

# ─── Setup ────────────────────────────────────────────────────────────────────
cmd_setup() {
  ensure_dirs
  need_cmd git

  if [[ ! -t 0 ]]; then
    die "$(m "setup needs a TTY. Edit manually: $IIUP_CONFIG" "setup TTY ister. Elle yaz: $IIUP_CONFIG")"
  fi

  echo
  echo "${C_BOLD}iiup setup${C_RST} — $(m "choose the dots repo to track" "takip edilecek dots’u seç")"
  echo

  if [[ -f "$IIUP_CONFIG" ]]; then
    load_config
    if is_configured; then
      warn "$(m "Current:" "Mevcut:") ${DOTS_NAME:-?} → $REPO_URL"
      confirm "$(m "Overwrite?" "Üzerine yazılsın mı?")" N || die "$(m "Cancelled." "İptal.")"
    fi
  fi

  local url branch dir name ucmd
  ask url "$(m "Git repo URL" "Git repo URL")"
  ask branch "$(m "Branch / tag" "Branch / tag")" "main"
  name="$(repo_basename_from_url "$url")"
  dir="$XDG_DATA_HOME/src/$name"
  ask dir "$(m "Local folder" "Yerel klasör")" "$dir"
  dir="$(expand_path "$dir")"

  echo
  echo "  ${C_BOLD}$name${C_RST}"
  echo "  $url  ($branch)"
  echo "  → $dir"
  echo
  confirm "$(m "Save and clone?" "Kaydet ve klonla?")" Y || die "$(m "Cancelled." "İptal.")"

  DOTS_NAME="$name"
  REPO_URL="$url"
  REPO_BRANCH="$branch"
  REPO_DIR="$dir"
  NOTIFY=1
  KEEP_BACKUPS=5
  CHECK_ON_CALENDAR="daily"

  if [[ -d "$REPO_DIR/.git" ]]; then
    ok "$(m "Clone already exists" "Clone zaten var")"
  else
    mkdir -p "$(dirname "$REPO_DIR")"
    info "$(m "Cloning…" "Klonlanıyor…")"
    git clone --recursive "$REPO_URL" "$REPO_DIR"
    (
      cd "$REPO_DIR"
      if git show-ref --verify --quiet "refs/remotes/origin/$REPO_BRANCH"; then
        git checkout "$REPO_BRANCH" 2>/dev/null || git checkout -B "$REPO_BRANCH" "origin/$REPO_BRANCH"
      elif git rev-parse --verify "$REPO_BRANCH^{commit}" >/dev/null 2>&1; then
        git checkout --detach "$REPO_BRANCH"
      fi
    )
    ok "$(m "Cloned" "Klonlandı")"
  fi

  ucmd="$(suggest_update_cmd "$REPO_DIR")"
  echo
  if [[ -n "$ucmd" ]]; then
    info "$(m "Install script found." "Kurulum betiği bulundu.")"
  else
    warn "$(m "No install script — git pull only." "Kurulum betiği yok — sadece git pull.")"
  fi
  ask ucmd "$(m "Post-pull command (empty = git only)" "Pull sonrası komut (boş = sadece git)")" "$ucmd"
  UPDATE_CMD="$ucmd"

  write_paths_template
  write_config_file
  cmd_install_link

  echo
  ok "$(m "Ready." "Hazır.")"
  printf "\n  ${C_DIM}%s${C_RST}\n" "$(m "Add paths to back up:" "Yedeklemek istediğin dosyaları ekle:")"
  printf "  ${C_DIM}%s/paths.list${C_RST}\n\n" "$IIUP_CONFIG_DIR"
  printf "  ${C_GRN}iiup check${C_RST}    %s\n" "$(m "any updates?" "güncelleme var mı?")"
  printf "  ${C_GRN}iiup update${C_RST}   %s\n" "$(m "safe update" "güvenli güncelle")"
  printf "  ${C_GRN}iiup doctor${C_RST}   %s\n" "$(m "health check" "sistem kontrolü")"
  if command -v systemctl >/dev/null 2>&1; then
    printf "  ${C_GRN}iiup timer on${C_RST}  %s\n" "$(m "daily notify" "günlük bildirim")"
  fi
  echo
}

# ─── Repo ─────────────────────────────────────────────────────────────────────
ensure_repo() {
  require_configured
  need_cmd git
  if [[ ! -d "$REPO_DIR/.git" ]]; then
    info "$(m "Cloning:" "Klonlanıyor:") $REPO_URL → $REPO_DIR"
    mkdir -p "$(dirname "$REPO_DIR")"
    git clone --recursive "$REPO_URL" "$REPO_DIR"
  fi
}

pretty_rev() {
  local dir="${1:-$REPO_DIR}"
  git -C "$dir" describe --tags --always --dirty 2>/dev/null \
    || git -C "$dir" rev-parse --short HEAD 2>/dev/null \
    || echo "?"
}

fetch_and_compare() {
  ensure_repo
  info "$(m "Checking upstream…" "Upstream kontrol…") ($REPO_BRANCH)"
  (
    cd "$REPO_DIR"
    git remote set-url origin "$REPO_URL" 2>/dev/null || true
    git fetch --tags --prune origin
  )

  local local_sha remote_sha local_pretty remote_pretty
  local_sha="$(git -C "$REPO_DIR" rev-parse HEAD)"
  local_pretty="$(pretty_rev "$REPO_DIR")"

  if git -C "$REPO_DIR" show-ref --verify --quiet "refs/remotes/origin/$REPO_BRANCH"; then
    remote_sha="$(git -C "$REPO_DIR" rev-parse "refs/remotes/origin/$REPO_BRANCH")"
    remote_pretty="$(git -C "$REPO_DIR" describe --tags --always "refs/remotes/origin/$REPO_BRANCH" 2>/dev/null || echo "${remote_sha:0:7}")"
  elif git -C "$REPO_DIR" rev-parse --verify "$REPO_BRANCH^{commit}" >/dev/null 2>&1; then
    remote_sha="$(git -C "$REPO_DIR" rev-parse "$REPO_BRANCH^{commit}")"
    remote_pretty="$(git -C "$REPO_DIR" describe --tags --always "$REPO_BRANCH" 2>/dev/null || echo "${remote_sha:0:7}")"
  else
    warn "$(m "Could not resolve branch/tag:" "Branch/tag çözülemedi:") $REPO_BRANCH"
    printf '%s %s %s %s\n' "$local_sha" "unknown" "$local_pretty" "?"
    return 2
  fi

  printf '%s %s %s %s\n' "$local_sha" "$remote_sha" "$local_pretty" "$remote_pretty"
  [[ "$local_sha" == "$remote_sha" ]] && return 0
  return 1
}

commit_distance() {
  local behind ahead
  behind="$(git -C "$REPO_DIR" rev-list --count "${1}..${2}" 2>/dev/null || echo "?")"
  ahead="$(git -C "$REPO_DIR" rev-list --count "${2}..${1}" 2>/dev/null || echo "?")"
  printf '%s %s\n' "$behind" "$ahead"
}

show_incoming() {
  local local_sha="$1" remote_sha="$2" behind
  behind="$(git -C "$REPO_DIR" rev-list --count "${local_sha}..${remote_sha}" 2>/dev/null || echo "?")"
  info "$(m "Incoming commits ($behind):" "Gelen commitler ($behind):")"
  git -C "$REPO_DIR" log --oneline -8 "${local_sha}..${remote_sha}" >&2 || true
}

dots_label() { printf '%s\n' "${DOTS_NAME:-dots}"; }

cmd_check() {
  require_configured
  ensure_dirs
  ensure_repo

  local cmp_out rc=0
  cmp_out="$(fetch_and_compare)" || rc=$?
  # shellcheck disable=SC2086
  set -- $cmp_out
  local local_sha="$1" remote_sha="$2" local_pretty="$3" remote_pretty="$4"

  echo >&2
  echo "${C_BOLD}$(dots_label)${C_RST}" >&2
  echo "  $(m "local:" "lokal:")  $local_pretty" >&2
  echo "  $(m "remote:" "uzak:")  $remote_pretty  ($REPO_BRANCH)" >&2

  if (( rc == 0 )); then
    ok "$(m "You're up to date." "Güncelsin.")"
    return 0
  elif (( rc == 2 )); then
    warn "$(m "Could not compare." "Karşılaştırılamadı.")"
    return 2
  fi

  show_incoming "$local_sha" "$remote_sha"
  printf "%s ${C_GRN}iiup update${C_RST}\n" "$(m "Update with:" "Güncelle:")" >&2
  local behind
  behind="$(commit_distance "$local_sha" "$remote_sha")"
  behind="${behind%% *}"
  notify critical "$(m "$(dots_label) update available" "$(dots_label) güncellemesi var")" \
    "$local_pretty → $remote_pretty ($behind). iiup update"
  return 1
}

cmd_watch() {
  load_config
  ensure_dirs
  local logfile="$LOG_DIR/watch-$(date +%Y%m%d).log"
  {
    echo "---- $(date -Iseconds) ----"
    if ! is_configured; then
      echo "not configured"
      return 0
    fi
    if [[ ! -d "$REPO_DIR/.git" ]]; then
      echo "no clone"
      return 0
    fi
  } >>"$logfile"

  local cmp_out rc=0
  cmp_out="$(fetch_and_compare 2>>"$logfile")" || rc=$?
  # shellcheck disable=SC2086
  set -- $cmp_out
  local local_sha="${1:-}" remote_sha="${2:-}" local_pretty="${3:-}" remote_pretty="${4:-}"
  echo "rc=$rc local=$local_pretty remote=$remote_pretty" >>"$logfile"

  if (( rc == 1 )); then
    local behind
    behind="$(commit_distance "$local_sha" "$remote_sha")"
    behind="${behind%% *}"
    notify critical "$(m "$(dots_label) update available" "$(dots_label) güncellemesi var")" \
      "$local_pretty → $remote_pretty ($behind). iiup update"
    echo "notify" >>"$logfile"
  fi
  return 0
}

# ─── Timer ────────────────────────────────────────────────────────────────────
systemd_dir() { printf '%s\n' "$HOME/.config/systemd/user"; }

write_systemd_units() {
  local dir bin cal
  dir="$(systemd_dir)"
  bin="$SCRIPT_PATH"
  [[ -x "$bin" ]] || die "$(m "iiup not found: $bin" "iiup yok: $bin")"
  cal="${CHECK_ON_CALENDAR:-daily}"
  mkdir -p "$dir"
  cat >"$dir/${UNIT_NAME}.service" <<EOF
[Unit]
Description=iiup dots check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=$bin watch
Nice=10
EOF
  cat >"$dir/${UNIT_NAME}.timer" <<EOF
[Unit]
Description=iiup daily check

[Timer]
OnCalendar=$cal
Persistent=true
RandomizedDelaySec=10m
Unit=${UNIT_NAME}.service

[Install]
WantedBy=timers.target
EOF
}

cmd_timer() {
  local sub="${1:-status}"
  case "$sub" in
    on|enable)
      require_configured
      need_cmd systemctl
      cmd_install_link
      write_systemd_units
      systemctl --user daemon-reload
      systemctl --user enable --now "${UNIT_NAME}.timer"
      ok "$(m "Daily check enabled ($CHECK_ON_CALENDAR)" "Günlük kontrol açık ($CHECK_ON_CALENDAR)")"
      systemctl --user list-timers "${UNIT_NAME}.timer" --no-pager || true
      ;;
    off|disable)
      need_cmd systemctl
      systemctl --user disable --now "${UNIT_NAME}.timer" 2>/dev/null || true
      ok "$(m "Daily check disabled" "Günlük kontrol kapalı")"
      ;;
    status|*)
      timer_status_line
      ;;
  esac
}

timer_status_line() {
  if ! command -v systemctl >/dev/null 2>&1; then
    echo "timer:  ($(m "no systemctl" "systemctl yok"))" >&2
    return
  fi
  if systemctl --user is-enabled "${UNIT_NAME}.timer" >/dev/null 2>&1; then
    local next
    next="$(systemctl --user show "${UNIT_NAME}.timer" -p NextElapseUSecRealtime --value 2>/dev/null || echo "?")"
    echo "timer:  ${C_GRN}$(m "on" "açık")${C_RST}  $(m "next:" "sonraki:") $next" >&2
  else
    echo "timer:  $(m "off" "kapalı")  →  iiup timer on" >&2
  fi
}

repo_update() {
  ensure_repo
  info "$(m "Updating repo…" "Repo güncelleniyor…")"
  (
    cd "$REPO_DIR"
    if [[ -n "$(git status --porcelain)" ]]; then
      warn "$(m "Repo is dirty (local changes)." "Repo kirli (yerel değişiklik var).")"
      if [[ -t 0 ]] && [[ "$ASSUME_YES" != "1" ]]; then
        confirm "$(m "Stash and continue?" "Stash alıp devam edilsin mi?")" Y || die "$(m "Cancelled." "İptal.")"
      fi
      git stash push -u -m "iiup-auto-$(date +%Y%m%d-%H%M%S)" || true
    fi
    if git show-ref --verify --quiet "refs/remotes/origin/$REPO_BRANCH"; then
      git checkout "$REPO_BRANCH"
      git pull --ff-only origin "$REPO_BRANCH"
    elif git rev-parse --verify "$REPO_BRANCH^{commit}" >/dev/null 2>&1; then
      git checkout --detach "$REPO_BRANCH"
    else
      die "$(m "Branch/tag not found:" "Branch/tag yok:") $REPO_BRANCH"
    fi
    [[ -f .gitmodules ]] && git submodule update --init --recursive
  )
  ok "Repo: $(pretty_rev)"
}

# ─── Backup ───────────────────────────────────────────────────────────────────
backup_path_list() {
  local p
  if declare -p BACKUP_EXTRA >/dev/null 2>&1; then
    for p in "${BACKUP_EXTRA[@]}"; do
      [[ -n "$p" ]] && printf '%s\n' "$(expand_path "$p")"
    done
  fi
  if [[ -f "$IIUP_CONFIG_DIR/paths.list" ]]; then
    while IFS= read -r p || [[ -n "$p" ]]; do
      [[ -z "$p" || "$p" =~ ^[[:space:]]*# ]] && continue
      printf '%s\n' "$(expand_path "$p")"
    done <"$IIUP_CONFIG_DIR/paths.list"
  fi
}

stamp_now() { date +%Y%m%d-%H%M%S; }
latest_pending() { [[ -f "$PENDING_FILE" ]] || return 1; cat "$PENDING_FILE"; }
set_pending() { printf '%s\n' "$1" >"$PENDING_FILE"; }
clear_pending() { rm -f "$PENDING_FILE"; }

do_backup() {
  local stamp="${1:-$(stamp_now)}"
  local dest="$BACKUP_ROOT/$stamp"
  local manifest="$dest/MANIFEST.txt"
  local count=0

  ensure_dirs
  mkdir -p "$dest/files"
  info "$(m "Backup →" "Yedek →") $dest"
  {
    echo "stamp=$stamp"
    echo "date=$(date -Iseconds)"
    echo "dots=${DOTS_NAME:-}"
    echo "repo=$(pretty_rev 2>/dev/null || echo n/a)"
  } >"$manifest"

  while IFS= read -r src; do
    [[ -e "$src" ]] || continue
    local rel="${src#"$HOME"/}"
    local target="$dest/files/$rel"
    mkdir -p "$(dirname "$target")"
    if [[ -d "$src" ]]; then
      cp -a "$src" "$(dirname "$target")/"
    else
      cp -a "$src" "$target"
    fi
    echo "OK $rel" >>"$manifest"
    count=$((count + 1))
  done < <(backup_path_list | awk 'NF && !seen[$0]++')

  if (( count == 0 )); then
    warn "$(m "Nothing to back up (paths.list may be empty)." "Yedeklenecek dosya yok (paths.list boş olabilir).")"
  fi
  printf 'file_count=%s\n' "$count" >>"$manifest"
  ok "$(m "Backup ($count items)" "Yedek ($count öğe)")"
  printf '%s\n' "$stamp"
}

do_restore() {
  local stamp="${1:-}"
  if [[ -z "$stamp" ]]; then
    stamp="$(latest_pending 2>/dev/null || true)"
  fi
  [[ -n "$stamp" ]] || die "$(m "Usage: iiup restore [id|latest]" "Kullanım: iiup restore [id|latest]")"
  if [[ "$stamp" == "latest" ]]; then
    stamp="$(ls -1 "$BACKUP_ROOT" 2>/dev/null | grep -E '^[0-9]{8}-' | sort | tail -1 || true)"
  fi
  local src_dir="$BACKUP_ROOT/$stamp/files"
  [[ -d "$src_dir" ]] || die "$(m "Backup not found:" "Yedek yok:") $stamp"

  warn "$(m "Restore:" "Geri yükleme:") $stamp → \$HOME"
  if [[ -t 0 ]] && [[ "$ASSUME_YES" != "1" ]]; then
    confirm "$(m "Continue?" "Devam?")" N || die "$(m "Cancelled." "İptal.")"
  fi

  if command -v rsync >/dev/null 2>&1; then
    rsync -a "$src_dir"/ "$HOME"/
  else
    cp -a "$src_dir"/. "$HOME"/
  fi
  ok "$(m "Restored:" "Geri yüklendi:") $stamp"
  notify "iiup" "$(m "Backup restored: $stamp" "Yedek geri yüklendi: $stamp")"
}

delete_backup() {
  local stamp="$1"
  rm -rf "$BACKUP_ROOT/$stamp" "$BACKUP_ROOT/$stamp.tar.gz"
  ok "$(m "Backup deleted:" "Yedek silindi:") $stamp"
}

prune_old_backups() {
  local keep="${KEEP_BACKUPS:-5}" i=0 pending
  mapfile -t stamps < <(ls -1 "$BACKUP_ROOT" 2>/dev/null | grep -E '^[0-9]{8}-' | grep -v '\.tar\.gz$' | sort -r)
  pending="$(latest_pending 2>/dev/null || true)"
  for s in "${stamps[@]:-}"; do
    [[ "$s" == "$pending" ]] && continue
    i=$((i + 1))
    (( i > keep )) && delete_backup "$s"
  done
}

# ─── Update ───────────────────────────────────────────────────────────────────
run_update_cmd() {
  ensure_repo
  local logfile="$LOG_DIR/update-$(stamp_now).log" rc=0

  if [[ -z "${UPDATE_CMD:-}" ]]; then
    ok "$(m "Git only (UPDATE_CMD empty)." "Sadece git güncellendi (UPDATE_CMD boş).")"
    return 0
  fi

  [[ "$(id -u)" -eq 0 ]] && die "$(m "Do not run as root." "Root ile çalıştırma.")"

  info "$(m "Running:" "Çalışıyor:") $UPDATE_CMD"
  info "Log: $logfile"
  set +e
  set -o pipefail
  (
    cd "$REPO_DIR"
    # shellcheck disable=SC2086
    eval "$UPDATE_CMD"
  ) 2>&1 | tee "$logfile"
  rc=${PIPESTATUS[0]}
  set +o pipefail
  set -e
  (( rc == 0 )) || return "$rc"
  ok "$(m "Command finished" "Komut bitti")"
}

cmd_update() {
  require_configured
  ensure_dirs

  for a in "$@"; do
    case "$a" in
      -f|--force) FORCE_UPDATE=1 ;;
      -y|--yes)   ASSUME_YES=1 ;;
    esac
  done

  if [[ -f "$PENDING_FILE" ]]; then
    warn "$(m "Previous update still pending:" "Önceki güncelleme onay bekliyor:") $(cat "$PENDING_FILE")"
    warn "  iiup ok      $(m "all good" "sorun yok")"
    warn "  iiup restore $(m "roll back" "geri al")"
    if [[ -t 0 ]] && [[ "$ASSUME_YES" != "1" ]]; then
      confirm "$(m "Update again anyway?" "Yine de yeni güncelleme?")" N || die "$(m "Cancelled." "İptal.")"
    else
      [[ "$ASSUME_YES" == "1" ]] || die "$(m "Pending backup exists." "Pending yedek var.")"
    fi
  fi

  local cmp_out rc=0
  cmp_out="$(fetch_and_compare)" || rc=$?
  # shellcheck disable=SC2086
  set -- $cmp_out
  local local_sha="$1" remote_sha="$2" local_pretty="$3" remote_pretty="$4"

  if (( rc == 0 )) && [[ "$FORCE_UPDATE" != "1" ]]; then
    ok "$(m "Already up to date." "Zaten güncelsin.")"
    printf "%s ${C_DIM}iiup update --force${C_RST}\n" "$(m "Force:" "Zorla:")" >&2
    return 0
  fi

  if (( rc == 0 )) && [[ "$FORCE_UPDATE" == "1" ]]; then
    warn "$(m "--force: will re-run install command." "--force: kurulum yeniden çalışacak.")"
  elif (( rc == 1 )); then
    show_incoming "$local_sha" "$remote_sha"
    echo
    echo "  $local_pretty  →  $remote_pretty"
    if [[ -n "${UPDATE_CMD:-}" ]]; then
      echo "  $(m "then:" "sonra:") $UPDATE_CMD"
    fi
    echo
    if [[ -t 0 ]] && [[ "$ASSUME_YES" != "1" ]]; then
      confirm "$(m "Back up and update?" "Yedek alıp güncelle?")" Y || die "$(m "Cancelled." "İptal.")"
    fi
  elif (( rc == 2 )); then
    die "$(m "Could not resolve upstream." "Upstream çözülemedi.")"
  fi

  local stamp
  stamp="$(do_backup)"
  set_pending "$stamp"

  repo_update

  local setup_rc=0
  run_update_cmd || setup_rc=$?

  if (( setup_rc != 0 )); then
    err "$(m "Command failed (exit $setup_rc)." "Komut başarısız (exit $setup_rc).")"
    err "$(m "Roll back: iiup restore" "Geri al: iiup restore")"
    notify critical "iiup" "$(m "Update failed — iiup restore" "Güncelleme başarısız — iiup restore")"
    exit "$setup_rc"
  fi

  echo
  ok "$(m "Update done. Backup kept:" "Güncelleme tamam. Yedek duruyor:") $stamp"
  printf "  %s  ${C_GRN}iiup ok${C_RST}\n" "$(m "All good:" "Sorun yoksa:")"
  printf "  %s   ${C_YLW}iiup restore${C_RST}\n" "$(m "Broken:" "Bozulduysa:")"
  notify "iiup" "$(m "$(dots_label) updated → iiup ok | iiup restore" "$(dots_label) güncellendi → iiup ok | iiup restore")"
}

cmd_ok() {
  load_config
  ensure_dirs
  local stamp
  stamp="$(latest_pending 2>/dev/null || true)"
  [[ -n "$stamp" ]] || die "$(m "No pending backup to confirm." "Onay bekleyen yedek yok.")"

  if [[ -t 0 ]] && [[ "$ASSUME_YES" != "1" ]]; then
    confirm "$(m "Delete backup? ($stamp)" "Yedek silinsin mi? ($stamp)")" Y || die "$(m "Cancelled — backup kept." "İptal — yedek duruyor.")"
  fi
  delete_backup "$stamp"
  clear_pending
  prune_old_backups
  ok "$(m "Confirmed." "Onaylandı.")"
  notify "iiup" "$(m "Backup cleaned up" "Yedek temizlendi")"
}

cmd_status() {
  load_config
  ensure_dirs
  {
    echo "${C_BOLD}iiup${C_RST} v$VERSION  [$IIUP_LANG]"
    if is_configured; then
      echo "dots:    $(dots_label)"
      echo "url:     $REPO_URL"
      echo "clone:   $REPO_DIR"
      echo "branch:  $REPO_BRANCH"
      echo "update:  ${UPDATE_CMD:-$(m "(git only)" "(sadece git)")}"
      if [[ -d "$REPO_DIR/.git" ]]; then
        echo "rev:     $(pretty_rev)"
      else
        echo "rev:     ($(m "no clone" "klon yok"))"
      fi
    else
      echo "dots:    ${C_YLW}$(m "unset" "tanımsız")${C_RST}  →  iiup setup"
    fi
    timer_status_line
    if [[ -f "$PENDING_FILE" ]]; then
      echo "pending: ${C_YLW}$(cat "$PENDING_FILE")${C_RST}  →  ok | restore"
    else
      echo "pending: $(m "none" "yok")"
    fi
    echo "$(m "backups:" "yedek:")  $BACKUP_ROOT"
    local n=0
    while IFS= read -r s; do
      n=1
      local mark=""
      [[ -f "$PENDING_FILE" && "$(cat "$PENDING_FILE")" == "$s" ]] && mark=" ${C_YLW}[pending]${C_RST}"
      printf '  - %s%s\n' "$s" "$mark"
    done < <(ls -1 "$BACKUP_ROOT" 2>/dev/null | grep -E '^[0-9]{8}-' | grep -v '\.tar\.gz$' | sort -r | head -10)
    (( n )) || echo "  ($(m "empty" "boş"))"
  } >&2
}

cmd_doctor() {
  load_config
  ensure_dirs
  local issues=0
  echo "${C_BOLD}iiup doctor${C_RST}  [$IIUP_LANG]" >&2

  if command -v git >/dev/null 2>&1; then
    ok "git"
  else
    err "$(m "git missing" "git yok")"; issues=$((issues + 1))
  fi

  if [[ -L "$HOME/.local/bin/iiup" || -x "$HOME/.local/bin/iiup" ]]; then
    ok "$(m "command:" "komut:") ~/.local/bin/iiup"
  else
    warn "$(m "no symlink → iiup install-link" "symlink yok → iiup install-link")"; issues=$((issues + 1))
  fi

  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ok "PATH: ~/.local/bin" ;;
    *) warn "$(m "~/.local/bin not in PATH" "~/.local/bin PATH'te değil")"; issues=$((issues + 1)) ;;
  esac

  if is_configured; then
    ok "config: $(dots_label)"
    if [[ -d "$REPO_DIR/.git" ]]; then
      ok "clone: $REPO_DIR ($(pretty_rev))"
    else
      warn "$(m "no clone:" "clone yok:") $REPO_DIR"
    fi
    if [[ -n "${UPDATE_CMD:-}" ]]; then
      ok "UPDATE_CMD: $UPDATE_CMD"
    else
      warn "$(m "UPDATE_CMD empty (git only)" "UPDATE_CMD boş (sadece git)")"
    fi
  else
    warn "$(m "dots not set → iiup setup" "dots tanımlı değil → iiup setup")"; issues=$((issues + 1))
  fi

  if [[ -f "$IIUP_CONFIG_DIR/paths.list" ]]; then
    local pc=0
    while IFS= read -r p; do
      [[ -z "$p" || "$p" =~ ^[[:space:]]*# ]] && continue
      pc=$((pc + 1))
    done <"$IIUP_CONFIG_DIR/paths.list"
    if (( pc > 0 )); then
      ok "paths.list: $pc $(m "paths" "yol")"
    else
      warn "$(m "paths.list empty — no custom file backup" "paths.list boş — özel dosya yedeklenmez")"
    fi
  else
    warn "$(m "paths.list missing" "paths.list yok")"
  fi

  command -v notify-send >/dev/null 2>&1 && ok "notify-send" || warn "$(m "notify-send missing (no desktop notify)" "notify-send yok (bildirim kapalı)")"
  command -v systemctl >/dev/null 2>&1 && timer_status_line || warn "$(m "systemctl missing (no timer)" "systemctl yok (timer yok)")"

  [[ -f "$PENDING_FILE" ]] && warn "$(m "pending backup:" "pending yedek:") $(cat "$PENDING_FILE")"

  echo
  if (( issues == 0 )); then
    ok "$(m "Looks good." "Sorun görünmüyor.")"
  else
    warn "$(m "$issues warning(s) — see above." "$issues uyarı — yukarıya bak.")"
  fi
  return 0
}

cmd_install_link() {
  local target="$HOME/.local/bin/iiup"
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$SCRIPT_PATH" "$target"
  ok "Symlink: $target"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) warn "$(m "~/.local/bin not in PATH" "~/.local/bin PATH'te değil")" ;;
  esac
  install_desktop_assets
}

usage() {
  if [[ "$IIUP_LANG" == "tr" ]]; then
    cat <<EOF
${C_BOLD}iiup${C_RST} v$VERSION — dotfiles güvenli güncelleyici

  iiup setup              Dots reposunu seç (ilk adım)
  iiup check              Güncelleme var mı?
  iiup update             Yedekle + çek + kur
  iiup ok                 Güncelleme tamam, yedeği sil
  iiup restore            Yedeğe geri dön
  iiup status             Durum
  iiup doctor             Kurulum kontrolü
  iiup timer on|off       Günlük bildirim

  iiup update --force     Zorla yeniden kur
  iiup update -y          Onay sorma
  iiup backup             Sadece yedek al

Dil: LANG / IIUP_LANG=en|tr  (şimdi: $IIUP_LANG)
Config: $IIUP_CONFIG
Yedek listesi: $IIUP_CONFIG_DIR/paths.list
EOF
  else
    cat <<EOF
${C_BOLD}iiup${C_RST} v$VERSION — safe git-based dotfiles updater

  iiup setup              Choose dots repo to track (first step)
  iiup check              Any upstream updates?
  iiup update             Backup + pull + install
  iiup ok                 All good — delete pending backup
  iiup restore            Roll back to backup
  iiup status             Status
  iiup doctor             Health check
  iiup timer on|off       Daily notify

  iiup update --force     Re-run install even if up to date
  iiup update -y          Skip confirmations
  iiup backup             Backup only

Language: LANG / IIUP_LANG=en|tr  (now: $IIUP_LANG)
Config: $IIUP_CONFIG
Backup list: $IIUP_CONFIG_DIR/paths.list
EOF
  fi
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    setup|configure)     cmd_setup "$@" ;;
    check|outdated)      cmd_check "$@" ;;
    watch)               cmd_watch "$@" ;;
    update|up)           cmd_update "$@" ;;
    ok|confirm|done)     cmd_ok "$@" ;;
    restore)             load_config; do_restore "${1:-}" ;;
    backup)              require_configured; do_backup >/dev/null ;;
    status|st)           cmd_status ;;
    doctor|dr)           cmd_doctor ;;
    timer)               cmd_timer "$@" ;;
    enable-timer|timer-on)   cmd_timer on ;;
    disable-timer|timer-off) cmd_timer off ;;
    install-link)        cmd_install_link ;;
    help|-h|--help)      usage ;;
    version|-V)          echo "iiup $VERSION" ;;
    health|list|ls)      cmd_status ;;
    init)                die "$(m "Use: iiup setup" "Kullan: iiup setup")" ;;
    *)                   err "$(m "Unknown command:" "Bilinmeyen komut:") $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
